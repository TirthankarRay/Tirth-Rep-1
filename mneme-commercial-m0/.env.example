# Postgres
POSTGRES_USER=mneme
POSTGRES_PASSWORD=mneme
POSTGRES_DB=mneme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Vault (path inside containers)
VAULT_PATH=/vault
VAULT_DEFAULT_BRANCH=main

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001

# Console API
CONSOLE_API_HOST=0.0.0.0
CONSOLE_API_PORT=8002

# Index sync
INDEX_SYNC_PORT=8003

# Embeddings (local; never call out)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Rule pack
RULE_PACK=commercial-mlr-strict
