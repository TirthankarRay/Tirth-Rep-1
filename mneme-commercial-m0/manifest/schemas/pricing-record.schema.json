{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mneme.local/schemas/pricing-record.schema.json",
  "title": "Pricing record",
  "allOf": [{ "$ref": "_core.schema.json" }],
  "type": "object",
  "required": ["currency", "effective_date"],
  "properties": {
    "type": { "const": "pricing-record" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "effective_date": { "type": "string", "format": "date" },
    "classification": {
      "type": "string",
      "enum": ["confidential", "restricted"]
    },
    "entities": {
      "type": "object",
      "required": ["brand"],
      "properties": {
        "brand": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
