{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mneme.local/schemas/launch-milestone.schema.json",
  "title": "Launch milestone",
  "allOf": [{ "$ref": "_core.schema.json" }],
  "type": "object",
  "required": ["due_date", "owner_team"],
  "properties": {
    "type": { "const": "launch-milestone" },
    "due_date": { "type": "string", "format": "date" },
    "owner_team": { "type": "string" },
    "status_marker": {
      "type": "string",
      "enum": ["green", "amber", "red", "complete"]
    },
    "entities": {
      "type": "object",
      "required": ["brand"],
      "properties": {
        "brand": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
