{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mneme.local/schemas/_core.schema.json",
  "title": "Core frontmatter",
  "description": "Required frontmatter fields for every Mneme knowledge file.",
  "type": "object",
  "required": [
    "id", "type", "title", "version", "owners", "status",
    "last_verified", "review_cycle", "classification", "audience",
    "residency", "sources", "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^kb-[a-z0-9-]{3,}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "brand-strategy",
        "competitive-landscape",
        "payer-coverage",
        "hcp-segmentation",
        "msl-insight",
        "launch-milestone",
        "pricing-record",
        "entity-profile"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "version": { "type": "integer", "minimum": 1 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^u:[a-z0-9-]+$" }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "approved", "deprecated"]
    },
    "last_verified": { "type": "string", "format": "date" },
    "review_cycle": { "type": "integer", "minimum": 1 },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^bu:[a-z0-9-]+$" }
    },
    "residency": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["us", "eu", "uk", "ca", "jp", "global"] }
    },
    "entities": { "type": "object" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "kind"],
        "properties": {
          "ref": { "type": "string", "minLength": 4 },
          "date": { "type": "string", "format": "date" },
          "kind": {
            "type": "string",
            "enum": ["external", "internal", "regulatory", "publication", "advisor"]
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  }
}
