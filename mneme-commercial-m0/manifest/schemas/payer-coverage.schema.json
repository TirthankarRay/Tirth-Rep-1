{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mneme.local/schemas/payer-coverage.schema.json",
  "title": "Payer coverage",
  "allOf": [{ "$ref": "_core.schema.json" }],
  "type": "object",
  "required": ["coverage_tier"],
  "properties": {
    "type": { "const": "payer-coverage" },
    "coverage_tier": {
      "type": "string",
      "enum": ["preferred", "tier1", "tier2", "tier3", "non-formulary", "step-edit", "prior-auth"]
    },
    "entities": {
      "type": "object",
      "required": ["brand", "payer"],
      "properties": {
        "brand": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "payer": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "indication": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
